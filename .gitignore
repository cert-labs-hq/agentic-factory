# 3. Application Runtimes (Hybrid Node/Python)
# ==========================================
# Node.js artifacts
node_modules/
dist/
build/
npm-debug.log*
yarn-error.log*

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
env/

