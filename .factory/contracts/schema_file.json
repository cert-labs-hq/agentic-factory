{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Slice Metadata Schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the slice (e.g., FACTORY-ALIGN-001)"
    },
    "title": {
      "type": "string",
      "description": "Short descriptive title of the slice"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planned",
        "In Progress",
        "In Review",
        "Approved",
        "Warehoused",
        "Rejected"
      ],
      "description": "Current lifecycle state of the slice"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of creation"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "assigned_to": {
      "type": "string",
      "description": "The agent or human responsible for the implementation"
    },
    "phase": {
      "type": "string",
      "enum": [
        "specs",
        "planning",
        "implementation",
        "validation"
      ],
      "description": "The development phase this slice belongs to"
    },
    "complexity": {
      "type": "string",
      "enum": ["Low", "Medium", "High"],
      "description": "Initial assessment of the slice complexity"
    },
    "forecast": {
      "type": "object",
      "properties": {
        "complexity": {
          "type": "string",
          "enum": ["Low", "Medium", "High"]
        },
        "estimated_tokens": {
          "type": "object",
          "properties": {
            "prompt": { "type": "integer", "minimum": 0 },
            "reasoning": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 }
          },
          "required": ["prompt", "reasoning", "output"]
        }
      },
      "required": ["complexity", "estimated_tokens"],
      "description": "Token and complexity forecast defined during the Planning phase"
    },
    "spec_path": {
      "type": "string",
      "description": "Path to the markdown specification or prompt file"
    },
    "prompt_source": {
      "type": "string",
      "description": "The origin of the prompt: either a file path or 'MANUAL' for direct user input"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of slice IDs that must be completed before this one"
    },
    "metadata_version": {
      "type": "string",
      "description": "Version of the metadata schema used"
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "created_at",
    "updated_at",
    "assigned_to",
    "spec_path",
    "dependencies",
    "metadata_version"
  ]
}
