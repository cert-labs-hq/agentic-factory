{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Slice Metadata Schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the slice (e.g., FACTORY-ALIGN-001)"
    },
    "title": {
      "type": "string",
      "description": "Short descriptive title of the slice"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planned",
        "In Progress",
        "In Review",
        "Approved",
        "Warehoused",
        "Rejected"
      ],
      "description": "Current lifecycle state of the slice"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of creation"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "assigned_to": {
      "type": "string",
      "description": "The agent or human responsible for the implementation"
    },
    "phase": {
      "type": "string",
      "enum": [
        "foundations",
        "specs",
        "planning",
        "implementation",
        "validation"
      ],
      "description": "The development phase this slice belongs to"
    },
    "token_usage": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "prompt": {
          "type": "integer",
          "minimum": 0
        },
        "completion": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "prompt",
        "completion"
      ]
    },
    "spec_path": {
      "type": "string",
      "description": "Path to the markdown specification or prompt file"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of slice IDs that must be completed before this one"
    },
    "metadata_version": {
      "type": "string",
      "description": "Version of the metadata schema used"
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "created_at",
    "updated_at",
    "assigned_to",
    "token_usage",
    "spec_path",
    "dependencies",
    "metadata_version"
  ]
}
